# === Passerelle FHIR — variables d'environnement (copier en .env, ne jamais committer) ===

# Base du serveur FHIR interrogé. Par défaut, le point d'entrée R4 du SMART App Launcher.
#
# Le journal écrit systématiquement la base qui a servi : un défaut qui pointe ailleurs
# qu'où l'on croit se paie en une journée de recherche dans le mauvais fichier.
PASSERELLE_FHIR_BASE=https://launch.smarthealthit.org/v/r4/sim/e30/fhir

# Délai maximal d'une requête FHIR, en secondes. Le bac à sable est public et partagé :
# une lenteur ne doit pas bloquer la démonstration, elle doit la faire dégrader.
PASSERELLE_FHIR_DELAI=10

# === Autorisation SMART on FHIR ===
# Identifiant de client. Le lanceur accepte n'importe quelle valeur ; un serveur réel exige
# un identifiant enregistré chez lui. Une valeur par serveur, comme la base FHIR.
PASSERELLE_SMART_CLIENT_ID=passerelle-fhir

# Scopes demandés. Syntaxe v1 par défaut, la plus largement acceptée — certains serveurs
# n'annoncent que la v2 (`patient/Condition.rs`). C'est la couture de portabilité : elle
# reste en configuration, jamais en dur.
PASSERELLE_SMART_SCOPES=launch/patient patient/Patient.read patient/Condition.read openid fhirUser

# === Serveur Multi-Terminologies (ANS) ===
PASSERELLE_SMT_BASE=https://smt.esante.gouv.fr/fhir

# Clé d'API personnelle, créée sur https://smt.esante.gouv.fr/api-keys/.
#
# **Facultative pour la résolution des codes** : `$lookup` répond sans authentification —
# mesuré. Elle ne protège que le téléchargement des référentiels entiers.
#
# Ce qu'elle atteste ne se lit pas dans une réponse HTTP : l'affiliation SNOMED CT au centre
# national français est ce qui rend l'usage licite, et les mentions du README en découlent.
PASSERELLE_SMT_CLE=

# === Service HTTP ===
# Adresse de retour du parcours d'autorisation, telle qu'annoncée au serveur SMART.
#
# Elle commande aussi l'attribut `Secure` du témoin de session : en `https://` il est posé,
# en `http://` il ne l'est pas. Les deux réglages décrivent la même chose — le service
# est-il derrière TLS — et les séparer les ferait diverger un jour.
#
# En production : https://fhir.lamoulinette.ai/smart/retour
PASSERELLE_REDIRECTION=http://localhost:8006/smart/retour

# Page qui reçoit le visiteur une fois le parcours terminé. Le retour d'autorisation atterrit
# sur l'API, pas sur le front : le jeton s'échange de serveur à serveur et ne traverse jamais
# le navigateur, qui ne porte qu'un témoin de session.
#
# Lue ici et jamais dans la requête : une adresse de retour choisie par un paramètre serait
# une redirection ouverte.
#
# En production : https://lamoulinette.ai/passerelle-fhir
PASSERELLE_FRONT=http://localhost:9000/passerelle-fhir

# Origines autorisées à appeler l'API depuis un navigateur.
#
# `www.` y figure comme chez le documentaliste : un visiteur qui atterrit sur
# `www.lamoulinette.ai` verrait sinon tous les appels de la page refusés, sans autre message
# qu'une erreur de console. L'origine de l'API elle-même n'a pas à y être — une requête vers
# sa propre origine n'est pas croisée.
CORS_ORIGINS=https://lamoulinette.ai,https://www.lamoulinette.ai   # local : http://localhost:9000
RATELIMIT_ENABLED=true
RATELIMIT=60/hour                      # consultations max par adresse et par heure

# === Moteur documentaire ===
# API du documentaliste. Appelée de serveur à serveur, jamais depuis le navigateur : depuis
# la page, on récupérerait un refus d'origine croisée, et surtout ces appels n'apparaîtraient
# dans aucune trace.
# En production, l'appel emprunte le réseau Docker dédié aux deux API :
#   PASSERELLE_DOCUMENTALISTE_API=http://documentaliste-api:8005
# Le limiteur de débit du documentaliste s'applique par adresse ; par l'URL publique, tous
# les visiteurs de la démonstration partageraient les 20 requêtes horaires de l'IP du VPS.
PASSERELLE_DOCUMENTALISTE_API=https://documentaliste.lamoulinette.ai

# Délai maximal d'une interrogation documentaire, en secondes. Plus long que pour FHIR :
# une question non mise en cache passe par la rédaction du modèle.
PASSERELLE_DOCUMENTALISTE_DELAI=30
